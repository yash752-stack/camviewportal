# CamView portal — environment. Copy to `.env` beside docker-compose (EC2) or into
# backend/.env (bare-metal), fill in the values, never commit the copy.
# Every key is read by backend/app/settings.py with the CAMVIEW_ prefix.

# ── where the portal runs ──────────────────────────────────────────────────────
CAMVIEW_ENVIRONMENT=production
# Working directory on the instance: uploaded workbooks, thumbnails, PDF renders,
# the evidence cache, and (only without RDS) the SQLite database. Mount an EBS
# volume here — the Dockerfile declares it as /data.
CAMVIEW_DATA_DIR=/data

# ── database: RDS Postgres ─────────────────────────────────────────────────────
# postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Leave empty to fall back to SQLite under CAMVIEW_DATA_DIR (single instance only).
CAMVIEW_DATABASE_URL=postgresql+psycopg://camview:CHANGE_ME@camview-db.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/camview
CAMVIEW_DB_SSLMODE=require
CAMVIEW_DB_POOL_SIZE=5
CAMVIEW_DB_MAX_OVERFLOW=10
CAMVIEW_DB_STATEMENT_TIMEOUT_MS=30000

# ── evidence frames: S3 ────────────────────────────────────────────────────────
# With backend=s3 every frame is uploaded to the bucket at ingest and streamed
# from it on demand; the instance disk becomes disposable. Credentials come from
# the EC2 instance role (preferred) or the AWS_* keys below.
CAMVIEW_STORAGE_BACKEND=s3
CAMVIEW_S3_BUCKET=camview-evidence-prod
CAMVIEW_S3_REGION=ap-south-1
# Optional key prefix inside the bucket, e.g. "portal" -> portal/evidence/<exam>/<alarm>.jpg
CAMVIEW_S3_PREFIX=

# Only when not running under an IAM role (workstation / non-AWS host):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── PDF export: headless Chromium inside the container ─────────────────────────
CAMVIEW_CHROME_PATH=/usr/bin/chromium
CAMVIEW_CHROME_CONTAINER=1

# ── retention ──────────────────────────────────────────────────────────────────
# 0 keeps examinations until deleted by hand (what a real deployment wants).
# A positive number of minutes purges each examination that long after upload.
CAMVIEW_RETENTION_MINUTES=0

# ── optional ───────────────────────────────────────────────────────────────────
# CAMVIEW_GOOGLE_MAPS_KEY=
# The port the container listens on (the compose file publishes it on 80).
PORT=8077
