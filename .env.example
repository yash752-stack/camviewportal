# CamView Examination Portal — deployment configuration
#
# Copy to `.env` beside this file and fill in. Every setting is read by
# backend/app/settings.py with the CAMVIEW_ prefix, so anything here can also
# be supplied as a real environment variable (systemd, ECS task definition,
# EC2 user-data) instead of a file. `.env` itself is gitignored — never commit
# a filled-in copy.

# local | staging | production
CAMVIEW_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Where the database, uploaded workbooks and the evidence vault live. On EC2
# point this at a mounted volume, NOT at the repo checkout — a deploy that
# replaces the working tree would otherwise take the exam data with it.
CAMVIEW_DATA_DIR=/var/lib/camview

# Leave empty to use SQLite inside CAMVIEW_DATA_DIR (fine for a single
# instance). Set a Postgres URL once there is more than one app process, or
# the moment you put this behind an autoscaling group.
# CAMVIEW_DATABASE_URL=postgresql+psycopg://camview:CHANGEME@your-rds-host:5432/camview
CAMVIEW_DATABASE_URL=

# local | s3   — s3 moves the evidence vault off the instance disk
CAMVIEW_STORAGE_BACKEND=local
CAMVIEW_S3_BUCKET=
CAMVIEW_S3_REGION=ap-south-1

# ---------------------------------------------------------------------------
# Assets and configuration files
# ---------------------------------------------------------------------------
# Absolute paths on the instance. Defaults resolve relative to the repo, which
# works if you deploy the checkout as-is.
# CAMVIEW_ASSETS_DIR=/opt/camview/assets
# CAMVIEW_MODALITIES_PATH=/opt/camview/config/modalities.json

# ---------------------------------------------------------------------------
# Centre imagery (optional)
# ---------------------------------------------------------------------------
# Google Maps Platform key, used by backend/app/centre_media.py for Street View
# and Static Maps. Leave empty and centre imagery falls back to the exam's own
# evidence frames — no external request is ever made without this key.
# Restrict the key by API and by referrer/IP before putting it on a host.
CAMVIEW_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# NOT YET WIRED — read this before going live
# ---------------------------------------------------------------------------
# backend/app/auth.py ships three hardcoded plaintext accounts (admin /
# operator / viewer) and a session cookie that never expires. That is a
# placeholder door, not authentication. Replace it with the directory
# integration before this serves a real examination.
